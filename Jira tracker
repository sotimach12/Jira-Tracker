import React, { useState } from 'react';

// 1. Define the exact columns from your Google Doc
const COLUMNS = [
  'Active Jiras',
  'Waiting Jiras',
  'Parked/Paused Jiras',
  'Done/Closed'
];

// 2. The default template matching "The Master File" structure
const emptyTask = {
  id: Date.now(),
  title: '',
  jiraId: '',
  status: 'Active Jiras',
  problem: '',
  searched: '',
  actions: '',
  notes: '',
  relatedFiles: '',
  qa: '',
  reporterResponse: 'Hello _,\n\nThank you for raising this inquiry.\n\n___\n\nKind Regards'
};

export default function WorkspaceTracker() {
  const [tasks, setTasks] = useState([]);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [currentTask, setCurrentTask] = useState(emptyTask);

  // Handle saving a task (New or Edited)
  const saveTask = () => {
    if (tasks.find(t => t.id === currentTask.id)) {
      setTasks(tasks.map(t => (t.id === currentTask.id ? currentTask : t)));
    } else {
      setTasks([...tasks, currentTask]);
    }
    setIsModalOpen(false);
  };

  const openNewTaskModal = () => {
    setCurrentTask({ ...emptyTask, id: Date.now() });
    setIsModalOpen(true);
  };

  return (
    <div className="min-h-screen bg-gray-100 p-8 font-sans">
      <div className="flex justify-between items-center mb-8">
        <h1 className="text-3xl font-bold text-gray-800">The Master File Tracker</h1>
        <button 
          onClick={openNewTaskModal}
          className="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700"
        >
          + New Jira Task
        </button>
      </div>

      {/* KANBAN BOARD VIEW */}
      <div className="flex gap-6 overflow-x-auto pb-4">
        {COLUMNS.map(column => (
          <div key={column} className="bg-gray-200 rounded-lg p-4 w-80 flex-shrink-0 min-h-[500px]">
            <h2 className="font-bold text-gray-700 mb-4 border-b pb-2 uppercase text-sm">
              {column} ({tasks.filter(t => t.status === column).length})
            </h2>
            
            <div className="space-y-4">
              {tasks.filter(t => t.status === column).map(task => (
                <div 
                  key={task.id} 
                  className="bg-white p-4 rounded shadow cursor-pointer hover:shadow-md border-l-4 border-blue-500"
                  onClick={() => { setCurrentTask(task); setIsModalOpen(true); }}
                >
                  <div className="text-xs font-bold text-blue-600 mb-1">{task.jiraId || 'NO-JIRA'}</div>
                  <div className="font-semibold text-gray-800 line-clamp-2">{task.title || 'Untitled Task'}</div>
                  <div className="text-xs text-gray-500 mt-2 truncate">
                    {task.problem || 'No description...'}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      {/* TASK TEMPLATE MODAL */}
      {isModalOpen && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-lg w-full max-w-3xl max-h-[90vh] overflow-y-auto p-6">
            <div className="flex justify-between items-center mb-6 border-b pb-4">
              <h2 className="text-2xl font-bold">Document Template</h2>
              <button onClick={() => setIsModalOpen(false)} className="text-gray-500 hover:text-red-500 font-bold text-xl">✕</button>
            </div>

            <div className="space-y-4">
              {/* Header Info */}
              <div className="flex gap-4">
                <div className="flex-1">
                  <label className="block text-sm font-bold text-gray-700">Title</label>
                  <input type="text" className="w-full border p-2 rounded" value={currentTask.title} onChange={e => setCurrentTask({...currentTask, title: e.target.value})} placeholder="e.g. Flexible Ticket: tracking usage" />
                </div>
                <div className="w-1/3">
                  <label className="block text-sm font-bold text-gray-700">Jira Link/ID</label>
                  <input type="text" className="w-full border p-2 rounded" value={currentTask.jiraId} onChange={e => setCurrentTask({...currentTask, jiraId: e.target.value})} placeholder="OPPR-11179" />
                </div>
                <div className="w-1/3">
                  <label className="block text-sm font-bold text-gray-700">Status</label>
                  <select className="w-full border p-2 rounded" value={currentTask.status} onChange={e => setCurrentTask({...currentTask, status: e.target.value})}>
                    {COLUMNS.map(col => <option key={col} value={col}>{col}</option>)}
                  </select>
                </div>
              </div>

              {/* Master File Template Fields */}
              <div>
                <label className="block text-sm font-bold text-gray-700">What’s the problem or task</label>
                <textarea className="w-full border p-2 rounded h-24" value={currentTask.problem} onChange={e => setCurrentTask({...currentTask, problem: e.target.value})} />
              </div>

              <div>
                <label className="block text-sm font-bold text-gray-700">Where I searched</label>
                <textarea className="w-full border p-2 rounded h-16" value={currentTask.searched} onChange={e => setCurrentTask({...currentTask, searched: e.target.value})} placeholder="Links to shelf pages, previous tickets..." />
              </div>

              <div>
                <label className="block text-sm font-bold text-gray-700">Actions</label>
                <textarea className="w-full border p-2 rounded h-24" value={currentTask.actions} onChange={e => setCurrentTask({...currentTask, actions: e.target.value})} placeholder="- Action item 1..." />
              </div>

              <div className="flex gap-4">
                <div className="flex-1">
                  <label className="block text-sm font-bold text-gray-700">Notes</label>
                  <textarea className="w-full border p-2 rounded h-24" value={currentTask.notes} onChange={e => setCurrentTask({...currentTask, notes: e.target.value})} />
                </div>
                <div className="flex-1">
                  <label className="block text-sm font-bold text-gray-700">Related Files</label>
                  <textarea className="w-full border p-2 rounded h-24" value={currentTask.relatedFiles} onChange={e => setCurrentTask({...currentTask, relatedFiles: e.target.value})} placeholder="➡️ Link 1&#10;➡️ Link 2" />
                </div>
              </div>

              <div>
                <label className="block text-sm font-bold text-gray-700">Questions & Answers</label>
                <textarea className="w-full border p-2 rounded h-24" value={currentTask.qa} onChange={e => setCurrentTask({...currentTask, qa: e.target.value})} placeholder="➡️ Question here&#10;↪️ Answer here" />
              </div>

              {/* Pre-filled Response to Reporter */}
              <div className="bg-gray-50 p-4 border rounded">
                <label className="block text-sm font-bold text-blue-800 mb-2">Response to Reporter</label>
                <textarea className="w-full border p-2 rounded h-32 font-mono text-sm" value={currentTask.reporterResponse} onChange={e => setCurrentTask({...currentTask, reporterResponse: e.target.value})} />
              </div>

            </div>

            <div className="mt-6 flex justify-end gap-4 border-t pt-4">
              <button onClick={() => setIsModalOpen(false)} className="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded">Cancel</button>
              <button onClick={saveTask} className="px-6 py-2 bg-green-600 text-white font-bold rounded hover:bg-green-700">Save Task</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
